<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitosX.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="680"
             x:Class="BitosX.App.Views.GeneratorPageView"
             x:DataType="vm:GeneratorPageViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Password generator" Classes="h1" />

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <!-- Not selectable: the password leaves only through Copy, which marks it as sensitive
                         and clears it again (docs/SECURITY_MODEL.md). -->
                    <TextBlock Name="GeneratedPassword" Text="{Binding GeneratedPassword}" FontFamily="Cascadia Code,Consolas,monospace"
                               FontSize="18" TextWrapping="Wrap" AutomationProperties.Name="Generated password" />
                    <TextBlock Name="StrengthText" Text="{Binding StrengthText}" Classes="muted" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Name="RegenerateButton" Content="Regenerate" Classes="accent" Command="{Binding GenerateCommand}" />
                        <Button Name="CopyButton" Content="Copy" Command="{Binding CopyCommand}" />
                    </StackPanel>
                    <TextBlock Name="StatusMessage" Text="{Binding StatusMessage}" Classes="muted"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="ErrorMessage" Text="{Binding ErrorMessage}" Classes="error"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Length" VerticalAlignment="Center" />
                            <TextBlock Name="LengthText" Text="{Binding Length}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Slider Name="LengthSlider" AutomationProperties.Name="Length of the password" Minimum="4" Maximum="256"
                                Value="{Binding Length}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </StackPanel>

                    <CheckBox Name="LowercaseCheckBox" Content="Lowercase (a–z)" IsChecked="{Binding IncludeLowercase}" />
                    <CheckBox Name="UppercaseCheckBox" Content="Uppercase (A–Z)" IsChecked="{Binding IncludeUppercase}" />
                    <CheckBox Name="DigitsCheckBox" Content="Digits (0–9)" IsChecked="{Binding IncludeDigits}" />
                    <CheckBox Name="SymbolsCheckBox" Content="Symbols (!@#…)" IsChecked="{Binding IncludeSymbols}" />
                    <CheckBox Name="ExcludeAmbiguousCheckBox" Content="Exclude ambiguous characters (I l 1 O 0 o)" IsChecked="{Binding ExcludeAmbiguous}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="The Generate button of the login editor uses these settings too." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
