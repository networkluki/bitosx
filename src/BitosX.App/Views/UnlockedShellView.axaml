<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitosX.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
             x:Class="BitosX.App.Views.UnlockedShellView"
             x:DataType="vm:UnlockedShellViewModel">

    <Grid ColumnDefinitions="220,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BitosXSurfaceBrush}"
                BorderBrush="{StaticResource BitosXBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="6,6,6,18">
                    <TextBlock Text="BitosX" Classes="h2" />
                    <TextBlock Text="Local vault" Classes="muted" FontSize="12" />
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="🔒  Lock Vault" Classes="nav"
                        Command="{Binding LockCommand}" Margin="0,10,0,0" />

                <StackPanel Spacing="4" VerticalAlignment="Top">
                    <Button Content="Vault" Classes="nav" Classes.selected="{Binding IsVaultSelected}"
                            Command="{Binding ShowVaultCommand}" />
                    <Button Content="Generator" Classes="nav" Classes.selected="{Binding IsGeneratorSelected}"
                            Command="{Binding ShowGeneratorCommand}" />
                    <Button Content="Security Center" Classes="nav" Classes.selected="{Binding IsSecuritySelected}"
                            Command="{Binding ShowSecurityCommand}" />
                    <Button Content="Settings" Classes="nav" Classes.selected="{Binding IsSettingsSelected}"
                            Command="{Binding ShowSettingsCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</UserControl>
