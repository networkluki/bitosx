<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitosX.App.ViewModels"
             xmlns:controls="using:BitosX.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
             x:Class="BitosX.App.Views.UnlockView"
             x:DataType="vm:UnlockViewModel">

    <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
            <TextBlock Text="BitosX" Classes="h1" HorizontalAlignment="Center" />
            <TextBlock Text="Unlock your vault" Classes="muted" HorizontalAlignment="Center" />

            <StackPanel Spacing="6">
                <TextBlock Text="Master password" />
                <controls:SecretBox Name="MasterPasswordBox" AutomationProperties.Name="Master password" Text="{Binding MasterPassword}" PlaceholderText="Enter your master password">
                    <controls:SecretBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
                    </controls:SecretBox.KeyBindings>
                </controls:SecretBox>
            </StackPanel>

            <TextBlock Name="ErrorMessage" Text="{Binding ErrorMessage}" Classes="error"
                       AutomationProperties.LiveSetting="Assertive"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

            <Button Name="UnlockButton" Content="Unlock" Classes="accent" HorizontalAlignment="Stretch"
                    Command="{Binding UnlockCommand}" IsEnabled="{Binding !IsBusy}" />

            <StackPanel Name="MissingVaultPanel" Spacing="8" IsVisible="{Binding IsVaultMissing}">
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="If the vault is gone for good, check again: BitosX then offers to create a new vault. A backup can be restored into it from Settings." />
                <Button Name="CheckVaultAgainButton" Content="Check again" HorizontalAlignment="Stretch"
                        Command="{Binding CheckAgainCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
