<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitosX.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="680"
             x:Class="BitosX.App.Views.VaultPageView"
             x:DataType="vm:VaultPageViewModel"
             x:Name="Root">

    <Panel>
        <!-- Out of reach of the keyboard while the editor is open in front of it. -->
        <DockPanel Name="VaultContent" Margin="24" IsEnabled="{Binding !IsEditorOpen}">
            <!-- Header -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <TextBlock Grid.Column="0" Text="Vault" Classes="h1" VerticalAlignment="Center" />
                <Button Name="AddLoginButton" Grid.Column="1" Content="+ Add login" Classes="accent"
                        Command="{Binding AddLoginCommand}" />
            </Grid>

            <TextBox Name="SearchBox" AutomationProperties.Name="Search" DockPanel.Dock="Top" Text="{Binding SearchText}" PlaceholderText="Search by name, username, or URL"
                     Margin="0,0,0,12" />

            <TextBlock Name="StatusMessage" DockPanel.Dock="Top" Text="{Binding StatusMessage}" Classes="muted" Margin="0,0,0,8"
                       AutomationProperties.LiveSetting="Polite"
                       IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Name="EmptyVaultNote" DockPanel.Dock="Top" Classes="muted" Margin="0,20,0,0"
                       Text="No logins yet. Click “Add login” to create your first entry."
                       IsVisible="{Binding IsVaultEmpty}" />

            <TextBlock Name="NoMatchesNote" DockPanel.Dock="Top" Classes="muted" Margin="0,20,0,0" TextWrapping="Wrap"
                       Text="{Binding NoMatchesText}" AutomationProperties.LiveSetting="Polite"
                       IsVisible="{Binding HasNoMatches}" />

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LoginItemViewModel">
                            <Border Classes="card" Margin="0,0,0,10" Padding="16,12">
                                <!-- The details have the full width of the card and the actions their own row,
                                     so neither squeezes the other in a narrow window. -->
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <!-- Favorite -->
                                    <Button Name="FavoriteButton" Classes="star" Grid.Row="0" Grid.Column="0" Content="{Binding FavoriteGlyph}" Background="Transparent"
                                            AutomationProperties.Name="{Binding FavoriteDescription}"
                                            Foreground="{StaticResource BitosXWarningBrush}" FontSize="18" Padding="6"
                                            VerticalAlignment="Top"
                                            Command="{Binding $parent[ItemsControl].((vm:VaultPageViewModel)DataContext).ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="{Binding FavoriteLabel}" />

                                    <!-- Details. A text too long for its line is shortened, and shown in full on hover. -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3" Margin="8,0,0,0">
                                        <TextBlock Name="ItemName" Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Name="ItemUsername" Text="{Binding Username}" Classes="muted" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Username}"
                                                   IsVisible="{Binding Username, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Name="ItemUrl" Text="{Binding PrimaryUrl}" Classes="muted" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrimaryUrl}"
                                                   IsVisible="{Binding PrimaryUrl, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                        <!-- Not selectable: a password leaves only through Copy, which marks it as
                                             sensitive and clears it again (docs/SECURITY_MODEL.md). -->
                                        <TextBlock Name="ItemPassword" Text="{Binding DisplayedPassword}" FontFamily="Cascadia Code,Consolas,monospace"
                                                   FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasPassword}" />
                                    </StackPanel>

                                    <!-- Deleting cannot be undone, so it is asked for twice. -->
                                    <Grid Name="DeleteConfirmation" Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,Auto"
                                          Margin="8,10,0,0" IsVisible="{Binding IsDeletePending}">
                                        <TextBlock Name="DeleteQuestion" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Text="Delete this login? This cannot be undone." />
                                        <Button Name="KeepButton" Grid.Column="1" Content="Keep" Margin="8,0,0,0"
                                                AutomationProperties.Name="{Binding KeepLabel}"
                                                Command="{Binding $parent[ItemsControl].((vm:VaultPageViewModel)DataContext).CancelDeleteCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Name="ConfirmDeleteButton" Grid.Column="2" Content="Delete" Margin="8,0,0,0"
                                                AutomationProperties.Name="{Binding ConfirmDeleteLabel}"
                                                Foreground="{StaticResource BitosXDangerBrush}"
                                                Command="{Binding $parent[ItemsControl].((vm:VaultPageViewModel)DataContext).DeleteLoginCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <!-- Actions -->
                                    <WrapPanel Name="ItemActions" Grid.Row="1" Grid.Column="1" Margin="4,8,0,0"
                                               IsVisible="{Binding !IsDeletePending}">
                                        <Button Name="ShowPasswordButton" Content="{Binding PasswordToggleGlyph}" Margin="4,2"
                                                AutomationProperties.Name="{Binding PasswordToggleLabel}"
                                                IsVisible="{Binding HasPassword}"
                                                Command="{Binding $parent[ItemsControl].((vm:VaultPageViewModel)DataContext).TogglePasswordVisibilityCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Name="CopyUsernameButton" Content="Copy username" Margin="4,2"
                                                AutomationProperties.Name="{Binding CopyUsernameLabel}"
                                                IsVisible="{Binding Username, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                Command="{Binding $parent[ItemsControl].((vm:VaultPageViewModel)DataContext).CopyUsernameCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Name="CopyPasswordButton" Content="Copy password" Margin="4,2"
                                                AutomationProperties.Name="{Binding CopyPasswordLabel}"
                                                IsVisible="{Binding HasPassword}"
                                                Command="{Binding $parent[ItemsControl].((vm:VaultPageViewModel)DataContext).CopyPasswordCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Name="EditButton" Content="Edit" Margin="4,2"
                                                AutomationProperties.Name="{Binding EditLabel}"
                                                Command="{Binding $parent[ItemsControl].((vm:VaultPageViewModel)DataContext).EditLoginCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Name="DeleteButton" Content="Delete" Margin="4,2" Foreground="{StaticResource BitosXDangerBrush}"
                                                Click="OnDeleteRequested"
                                                AutomationProperties.Name="{Binding DeleteLabel}"
                                                Command="{Binding $parent[ItemsControl].((vm:VaultPageViewModel)DataContext).RequestDeleteCommand}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Editor overlay. The margin keeps the editor inside the window; it scrolls when it does not fit. -->
        <Border Name="EditorOverlay" Background="#B3000000" IsVisible="{Binding IsEditorOpen}" Padding="16">
            <ContentControl Content="{Binding Editor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Panel>
</UserControl>
