<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitosX.App.ViewModels"
             xmlns:controls="using:BitosX.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="680"
             x:Class="BitosX.App.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Classes="h1" />

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Vault" Classes="h2" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Vault file location" Classes="muted" FontSize="12" />
                        <SelectableTextBlock Name="VaultLocation" Text="{Binding VaultLocation}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Name="LockNowButton" AutomationProperties.Name="Lock now"
                            Command="{Binding LockVaultCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource BitosXLockIcon}" Width="14" Height="14"
                                      Foreground="{StaticResource BitosXWarningBrush}" />
                            <TextBlock Text="Lock now" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Auto-lock" Classes="h2" />

                    <CheckBox Name="AutoLockCheckBox" IsChecked="{Binding AutoLockOnInactivity}"
                              Content="Lock automatically after a period of inactivity" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsEnabled="{Binding AutoLockOnInactivity}">
                        <TextBlock Text="Lock after" VerticalAlignment="Center" />
                        <NumericUpDown Name="InactivityMinutesBox" AutomationProperties.Name="Minutes of no activity before the vault locks" Value="{Binding InactivityMinutes}" Minimum="1" Maximum="1440"
                                       Increment="1" FormatString="0" Width="120" />
                        <TextBlock Text="minutes of no activity in BitosX" VerticalAlignment="Center" Classes="muted" />
                    </StackPanel>

                    <CheckBox Name="LockOnMinimizeCheckBox" IsChecked="{Binding LockOnMinimize}"
                              Content="Lock when the window is minimized" />

                    <TextBlock Name="AutoLockStatus" Text="{Binding AutoLockStatus}" TextWrapping="Wrap" Classes="error"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding AutoLockStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="Workstation lock" Classes="muted" FontSize="12" />
                        <TextBlock Name="SessionLockSupport" Text="{Binding SessionLockSupport}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="System sleep / suspend" Classes="muted" FontSize="12" />
                        <TextBlock Name="SuspendSupport" Text="{Binding SuspendSupport}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Change master password" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Re-protects your existing vault with a new password. The vault contents are not re-encrypted and no data is lost." />
                    <controls:SecretBox Name="CurrentPasswordBox" AutomationProperties.Name="Current password" PlaceholderText="Current password" Text="{Binding CurrentPassword}" />
                    <controls:SecretBox Name="NewPasswordBox" AutomationProperties.Name="New password" PlaceholderText="New password" Text="{Binding NewPassword}" />
                    <TextBlock Name="NewPasswordStrength" Text="{Binding NewPasswordStrengthText}" Classes="muted" FontSize="12"
                               IsVisible="{Binding NewPasswordStrengthText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <controls:SecretBox Name="ConfirmPasswordBox" AutomationProperties.Name="Confirm new password" PlaceholderText="Confirm new password" Text="{Binding ConfirmPassword}" />
                    <Button Name="ChangePasswordButton" Content="Change password" Command="{Binding ChangeMasterPasswordCommand}" HorizontalAlignment="Left" />
                    <TextBlock Name="ChangePasswordProgress" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsChangingMasterPassword}"
                               AutomationProperties.LiveSetting="Polite" Text="Changing the master password… this takes a few seconds." />
                    <TextBlock Name="ChangePasswordStatus" Text="{Binding ChangePasswordStatus}" TextWrapping="Wrap" Classes="muted"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding ChangePasswordStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Rotate vault key" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Generates a new encryption key and re-encrypts your entire vault under it, retiring the previous key. Your items and master password are unchanged. Requires your current master password." />
                    <controls:SecretBox Name="RotatePasswordBox" AutomationProperties.Name="Current password, to rotate the vault key" PlaceholderText="Current password" Text="{Binding RotatePassword}" />
                    <Button Name="RotateVaultKeyButton" Content="Rotate vault key" Command="{Binding RotateVaultKeyCommand}" HorizontalAlignment="Left" />
                    <TextBlock Name="RotateProgress" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsRotating}"
                               AutomationProperties.LiveSetting="Polite" Text="Rotating the vault key… this takes a few seconds." />
                    <TextBlock Name="RotateStatus" Text="{Binding RotateStatus}" TextWrapping="Wrap" Classes="muted"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding RotateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Strengthen key derivation" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Makes every guess at your master password more expensive for someone who has a copy of the vault file, by requiring more memory to derive the key. Unlocking takes longer and needs that memory on every device the vault is opened on. Your items and master password are unchanged. The settings can be strengthened, never weakened. Requires your current master password." />

                    <TextBlock Name="KeyDerivationAtStrongest" TextWrapping="Wrap"
                               Text="This vault already uses the strongest settings BitosX offers."
                               IsVisible="{Binding !CanStrengthenKeyDerivation}" />

                    <StackPanel Name="KeyDerivationPanel" Spacing="10" IsVisible="{Binding CanStrengthenKeyDerivation}">
                        <ComboBox Name="KeyDerivationChoices" AutomationProperties.Name="Key-derivation settings to move to" ItemsSource="{Binding KeyDerivationChoices}"
                                  SelectedItem="{Binding SelectedKeyDerivation}"
                                  DisplayMemberBinding="{Binding Display}" HorizontalAlignment="Stretch" />
                        <Button Name="TestKeyDerivationButton" Content="Measure on this device"
                                Command="{Binding TestKeyDerivationCommand}" HorizontalAlignment="Left" />
                        <TextBlock Name="KeyDerivationTestResult" Text="{Binding KeyDerivationTestResult}"
                                   TextWrapping="Wrap" Classes="muted"
                                   IsVisible="{Binding KeyDerivationTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <controls:SecretBox Name="StrengthenPasswordBox" AutomationProperties.Name="Current password, to strengthen the key derivation" PlaceholderText="Current password"
                                 Text="{Binding StrengthenPassword}" />
                        <Button Name="StrengthenKeyDerivationButton" Content="Strengthen key derivation"
                                Command="{Binding StrengthenKeyDerivationCommand}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock Name="StrengthenStatus" Text="{Binding StrengthenStatus}" TextWrapping="Wrap" Classes="muted"
                               IsVisible="{Binding StrengthenStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Backup &amp; Restore" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="An encrypted backup is a copy of your vault, protected by the master password that was active when it was made. It contains no plaintext. BitosX cannot recover a forgotten backup password." />

                    <Button Name="ExportBackupButton" Content="Export encrypted backup…" Command="{Binding ExportBackupCommand}" HorizontalAlignment="Left" />
                    <TextBlock Name="BackupStatus" Text="{Binding BackupStatus}" TextWrapping="Wrap" Classes="muted"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Border Height="1" Background="#33888888" Margin="0,6" />

                    <TextBlock Text="Restore replaces your current vault." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Name="ChooseBackupButton" Grid.Column="0" Content="Choose backup file…" Command="{Binding ChooseRestoreFileCommand}" />
                        <!-- A file name too long for the line is shortened, and shown in full on hover. -->
                        <TextBlock Name="SelectedBackupName" Grid.Column="1" Text="{Binding SelectedBackupName}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Classes="muted"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedBackupName}"
                                   IsVisible="{Binding HasSelectedBackup}" />
                    </Grid>
                    <controls:SecretBox Name="RestorePasswordBox" AutomationProperties.Name="Master password of the backup" PlaceholderText="Backup master password" Text="{Binding RestoreBackupPassword}"
                             IsVisible="{Binding HasSelectedBackup}" />
                    <Button Name="ValidateBackupButton" Content="Validate backup" Command="{Binding ValidateRestoreCommand}" HorizontalAlignment="Left"
                            IsVisible="{Binding HasSelectedBackup}" />
                    <TextBlock Name="ValidateProgress" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsValidatingRestore}"
                               AutomationProperties.LiveSetting="Polite" Text="Checking the backup with its master password… this takes a few seconds." />
                    <TextBlock Name="RestoreStatus" Text="{Binding RestoreStatus}" TextWrapping="Wrap" Classes="muted"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding RestoreStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Border x:Name="RestoreConfirmPanel" IsVisible="{Binding IsRestorePending}" Padding="12" CornerRadius="6" Background="#22CC3333">
                        <StackPanel Spacing="8">
                            <TextBlock Text="This will REPLACE your current vault." FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Name="RestoreSummary" Text="{Binding RestoreSummary}" TextWrapping="Wrap" Classes="muted" />
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="After restoring, unlock with the backup's master password. Your current vault is saved first as a recovery copy next to it (vault.bitosx.pre-restore; the three before it are kept too). If you use Sync, the restored vault is what the next “Sync now” uploads, replacing the server's vault for every device." />
                            <CheckBox Name="RestoreAcknowledgeCheckBox" IsChecked="{Binding RestoreAcknowledged}"
                                      Content="I understand that this will replace my current vault." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Disabled until the acknowledgement is checked (ConfirmRestoreCommand.CanExecute);
                                     deliberately NOT the default button and not initially focused. -->
                                <Button Name="ReplaceVaultButton" Content="Replace my vault" Command="{Binding ConfirmRestoreCommand}" />
                                <!-- IsCancel routes the Escape key here; also receives initial focus (code-behind). -->
                                <Button x:Name="RestoreCancelButton" Content="Cancel"
                                        Command="{Binding CancelRestoreCommand}" IsCancel="True" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Name="ImportExportCard" Classes="card">
                <StackPanel Spacing="10" DataContext="{Binding ImportExport}" x:DataType="vm:ImportExportViewModel">
                    <TextBlock Text="Import and export" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Import adds the logins of a file that another password manager exported: a CSV file (as Chrome, Edge, Firefox, Bitwarden, KeePassXC and others write them), Bitwarden's unencrypted JSON, KeePass 2 XML, or BitosX's own JSON export. You are shown what would be added first, and nothing is added until you confirm." />

                    <Grid ColumnDefinitions="Auto,*">
                        <Button Name="ChooseImportFileButton" Grid.Column="0" Content="Choose a file to import…" Command="{Binding ChooseImportFileCommand}" />
                        <!-- A file name too long for the line is shortened, and shown in full on hover. -->
                        <TextBlock Name="ImportFileName" Grid.Column="1" Text="{Binding ImportFileName}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Classes="muted"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ImportFileName}"
                                   IsVisible="{Binding HasImportFile}" />
                    </Grid>
                    <TextBlock Name="ImportReadingProgress" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsReadingImport}"
                               AutomationProperties.LiveSetting="Polite" Text="Reading the file…" />
                    <TextBlock Name="ImportStatus" Text="{Binding ImportStatus}" TextWrapping="Wrap" Classes="muted"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding ImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="ImportFileReminder" Text="{Binding ImportReminder}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding ImportReminder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- What importing the file would do. Counts, names and reasons only: nothing here is
                         bound to a password, an authenticator key, notes or the value of a custom field. -->
                    <Border Name="ImportPreviewPanel" IsVisible="{Binding HasImportPreview}" Padding="12" CornerRadius="6" Background="#225B8DEF">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Nothing has been added yet." FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Name="ImportSource" Text="{Binding Preview.Source}" TextWrapping="Wrap" Classes="muted" />
                            <TextBlock Name="ImportToAdd" Text="{Binding Preview.ToAdd}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Name="ImportOverLimit" Text="{Binding Preview.OverLimit}" Classes="error"
                                       IsVisible="{Binding Preview.OverLimit, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Name="ImportDuplicates" Text="{Binding Preview.Duplicates}" TextWrapping="Wrap"
                                       IsVisible="{Binding Preview.Duplicates, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <StackPanel Name="ImportNotImportedPanel" Spacing="6"
                                        IsVisible="{Binding Preview.NotImported, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Name="ImportNotImported" Grid.Column="0" Text="{Binding Preview.NotImported}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Name="ToggleNotImportedButton" Grid.Column="1" Margin="8,0,0,0" Content="{Binding NotImportedToggleText}"
                                            AutomationProperties.Name="Show or hide the entries that cannot be imported"
                                            Command="{Binding ToggleNotImportedListCommand}" />
                                </Grid>
                                <!-- Each entry by its position, its name and the reason. A name comes from the file: it has a
                                     text block of its own, is on one line, and is shortened if it does not fit. -->
                                <ScrollViewer Name="ImportNotImportedList" MaxHeight="220" IsVisible="{Binding IsNotImportedListShown}">
                                    <StackPanel Spacing="2">
                                        <ItemsControl ItemsSource="{Binding Preview.NotImportedEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ImportPreviewEntry">
                                                    <StackPanel Spacing="1" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <TextBlock Name="NotImportedPosition" Grid.Column="0" Text="{Binding Position}" Classes="muted" FontSize="12" />
                                                            <TextBlock Name="NotImportedName" Grid.Column="1" Margin="8,0,0,0" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                                                                       IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        </Grid>
                                                        <TextBlock Name="NotImportedReason" Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" Classes="muted" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Name="ImportNotImportedMore" Text="{Binding Preview.NotImportedMore}" TextWrapping="Wrap" FontSize="12" Classes="muted"
                                                   IsVisible="{Binding Preview.NotImportedMore, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>

                            <TextBlock Name="ImportUnsupported" Text="{Binding Preview.Unsupported}" TextWrapping="Wrap"
                                       IsVisible="{Binding Preview.Unsupported, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Name="ImportInTrash" Text="{Binding Preview.InTrash}" TextWrapping="Wrap"
                                       IsVisible="{Binding Preview.InTrash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Name="ImportEmpty" Text="{Binding Preview.Empty}" TextWrapping="Wrap"
                                       IsVisible="{Binding Preview.Empty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Name="ImportExtras" Text="{Binding Preview.Extras}" TextWrapping="Wrap"
                                       IsVisible="{Binding Preview.Extras, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Name="ImportHttpsAdded" Text="{Binding Preview.HttpsAdded}" TextWrapping="Wrap"
                                       IsVisible="{Binding Preview.HttpsAdded, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Name="ImportNamesDerived" Text="{Binding Preview.NamesDerived}" TextWrapping="Wrap"
                                       IsVisible="{Binding Preview.NamesDerived, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Name="ImportIgnoredColumns" Text="{Binding Preview.IgnoredColumns}" TextWrapping="Wrap" Classes="muted"
                                       IsVisible="{Binding Preview.IgnoredColumns, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <CheckBox Name="CopyExtrasCheckBox" IsChecked="{Binding CopyExtrasToNotes}" IsEnabled="{Binding CanChangeImportChoices}"
                                      Content="{Binding CopyExtrasText}" />
                            <CheckBox Name="ImportDuplicatesCheckBox" IsChecked="{Binding ImportDuplicates}" IsEnabled="{Binding CanChangeImportChoices}"
                                      Content="{Binding ImportDuplicatesText}" />

                            <TextBlock Name="ImportApplyingProgress" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsApplyingImport}"
                                       AutomationProperties.LiveSetting="Polite" Text="Adding the logins to the vault…" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Enabled only while the preview above is the one the two choices ask for
                                     (ConfirmImportCommand.CanExecute). Not the default button. -->
                                <Button Name="ConfirmImportButton" Content="{Binding Preview.ConfirmText}" Command="{Binding ConfirmImportCommand}" />
                                <Button Name="CancelImportButton" Content="Cancel"
                                        AutomationProperties.Name="Cancel the import" Command="{Binding CancelImportCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#33888888" Margin="0,6" />

                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Export writes every login of this vault to a file that is not encrypted, for another password manager to read. It asks for your master password again. To keep a copy of your vault, use the encrypted backup above instead." />
                    <Button Name="ExportUnencryptedButton" Content="Export unencrypted…" Command="{Binding OpenExportCommand}" HorizontalAlignment="Left" />

                    <Border Name="ExportPanel" IsVisible="{Binding IsExportOpen}" Padding="12" CornerRadius="6" Background="#22CC3333">
                        <StackPanel Spacing="8">
                            <TextBlock Text="This file will NOT be encrypted." FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Name="ExportWarning" Text="{Binding ExportWarning}" TextWrapping="Wrap" />

                            <TextBlock Text="Format" Classes="muted" FontSize="12" />
                            <RadioButton Name="ExportCsvRadio" GroupName="ExportFormat" IsChecked="{Binding IsExportCsv}"
                                         AutomationProperties.Name="Export format: CSV" Content="CSV" />
                            <RadioButton Name="ExportJsonRadio" GroupName="ExportFormat" IsChecked="{Binding IsExportJson}"
                                         AutomationProperties.Name="Export format: BitosX JSON" Content="BitosX JSON" />
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="CSV is the layout Chrome exports, which most password managers read; it holds one address for each item. BitosX JSON holds everything, every address included." />
                            <TextBlock Name="ExportSeveralUrlsNote" Text="{Binding ExportSeveralUrlsNote}" TextWrapping="Wrap"
                                       IsVisible="{Binding ExportSeveralUrlsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <CheckBox Name="ExportAcknowledgeCheckBox" IsChecked="{Binding ExportAcknowledged}"
                                      Content="{Binding ExportAcknowledgementText}" />
                            <controls:SecretBox Name="ExportPasswordBox" AutomationProperties.Name="Master password, to export the vault unencrypted"
                                                PlaceholderText="Master password" Text="{Binding ExportPassword}" />
                            <TextBlock Name="ExportProgress" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsExporting}"
                                       AutomationProperties.LiveSetting="Polite" Text="Checking the master password and writing the file… this takes a few seconds." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Disabled until the acknowledgement is ticked and a password is typed
                                     (WriteExportCommand.CanExecute). Not the default button. -->
                                <Button Name="WriteExportButton" Content="Export…" Command="{Binding WriteExportCommand}" />
                                <Button Name="CancelExportButton" Content="Cancel"
                                        AutomationProperties.Name="Cancel the export" Command="{Binding CancelExportCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Name="ExportStatus" Text="{Binding ExportStatus}" TextWrapping="Wrap" Classes="muted"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding ExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Security" Classes="h2" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Key derivation" Classes="muted" FontSize="12" />
                        <TextBlock Name="KdfDescription" Text="{Binding KdfDescription}" TextWrapping="Wrap" />
                        <TextBlock Name="KdfWarning" Text="{Binding KdfWarning}" TextWrapping="Wrap" Classes="error"
                                   IsVisible="{Binding KdfWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <StackPanel Spacing="2"
                                IsVisible="{Binding PasswordEncodingNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="Master password encoding" Classes="muted" FontSize="12" />
                        <TextBlock Name="PasswordEncodingNote" Text="{Binding PasswordEncodingNote}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Encryption" Classes="muted" FontSize="12" />
                        <TextBlock Name="AlgorithmDescription" Text="{Binding AlgorithmDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Clipboard" Classes="muted" FontSize="12" />
                        <TextBlock Name="ClipboardClearDescription" Text="{Binding ClipboardClearDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Server integration" Classes="muted" FontSize="12" />
                        <TextBlock Name="ServerIntegrationDescription" Text="{Binding ServerIntegrationDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="About" Classes="h2" />
                    <TextBlock Name="AppVersion" Text="{Binding AppVersion, StringFormat='BitosX version {0}'}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Your vault is encrypted on this device. If you use Sync (on the Account page), the encrypted vault file — never the master password, the vault key or anything decrypted — is stored on the BitosX server, which cannot open it. Without Sync, the vault stays on this device." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
