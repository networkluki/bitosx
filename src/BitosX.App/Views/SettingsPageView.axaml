<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitosX.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="680"
             x:Class="BitosX.App.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Classes="h1" />

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Vault" Classes="h2" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Vault file location" Classes="muted" FontSize="12" />
                        <SelectableTextBlock Text="{Binding VaultLocation}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Content="🔒 Lock now" Command="{Binding LockVaultCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Auto-lock" Classes="h2" />

                    <CheckBox IsChecked="{Binding AutoLockOnInactivity}"
                              Content="Lock automatically after a period of inactivity" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsEnabled="{Binding AutoLockOnInactivity}">
                        <TextBlock Text="Lock after" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding InactivityMinutes}" Minimum="1" Maximum="1440"
                                       Increment="1" FormatString="0" Width="120" />
                        <TextBlock Text="minutes of no activity in BitosX" VerticalAlignment="Center" Classes="muted" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding LockOnMinimize}"
                              Content="Lock when the window is minimized" />

                    <TextBlock Text="{Binding AutoLockStatus}" TextWrapping="Wrap" Classes="error"
                               IsVisible="{Binding AutoLockStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="Workstation lock" Classes="muted" FontSize="12" />
                        <TextBlock Text="{Binding SessionLockSupport}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="System sleep / suspend" Classes="muted" FontSize="12" />
                        <TextBlock Text="{Binding SuspendSupport}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Change master password" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Re-protects your existing vault with a new password. The vault contents are not re-encrypted and no data is lost." />
                    <TextBox PasswordChar="●" PlaceholderText="Current password" Text="{Binding CurrentPassword}" />
                    <TextBox PasswordChar="●" PlaceholderText="New password" Text="{Binding NewPassword}" />
                    <TextBlock Text="{Binding NewPasswordStrengthText}" Classes="muted" FontSize="12"
                               IsVisible="{Binding NewPasswordStrengthText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBox PasswordChar="●" PlaceholderText="Confirm new password" Text="{Binding ConfirmPassword}" />
                    <Button Content="Change password" Command="{Binding ChangeMasterPasswordCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ChangePasswordStatus}" TextWrapping="Wrap" Classes="muted"
                               IsVisible="{Binding ChangePasswordStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Rotate vault key" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Generates a new encryption key and re-encrypts your entire vault under it, retiring the previous key. Your items and master password are unchanged. Requires your current master password." />
                    <TextBox PasswordChar="●" PlaceholderText="Current password" Text="{Binding RotatePassword}" />
                    <Button Content="Rotate vault key" Command="{Binding RotateVaultKeyCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding RotateStatus}" TextWrapping="Wrap" Classes="muted"
                               IsVisible="{Binding RotateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Backup &amp; Restore" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="An encrypted backup is a copy of your vault, protected by the master password that was active when it was made. It contains no plaintext. BitosX cannot recover a forgotten backup password." />

                    <Button Content="Export encrypted backup…" Command="{Binding ExportBackupCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding BackupStatus}" TextWrapping="Wrap" Classes="muted"
                               IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Border Height="1" Background="#33888888" Margin="0,6" />

                    <TextBlock Text="Restore replaces your current vault." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Choose backup file…" Command="{Binding ChooseRestoreFileCommand}" />
                        <TextBlock Text="{Binding SelectedBackupName}" VerticalAlignment="Center" Classes="muted"
                                   IsVisible="{Binding HasSelectedBackup}" />
                    </StackPanel>
                    <TextBox PasswordChar="●" PlaceholderText="Backup master password" Text="{Binding RestoreBackupPassword}"
                             IsVisible="{Binding HasSelectedBackup}" />
                    <Button Content="Validate backup" Command="{Binding ValidateRestoreCommand}" HorizontalAlignment="Left"
                            IsVisible="{Binding HasSelectedBackup}" />
                    <TextBlock Text="{Binding RestoreStatus}" TextWrapping="Wrap" Classes="muted"
                               IsVisible="{Binding RestoreStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Border x:Name="RestoreConfirmPanel" IsVisible="{Binding IsRestorePending}" Padding="12" CornerRadius="6" Background="#22CC3333">
                        <StackPanel Spacing="8">
                            <TextBlock Text="This will REPLACE your current vault." FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RestoreSummary}" TextWrapping="Wrap" Classes="muted" />
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="After restoring, unlock with the backup's master password. Your current vault is saved as a recovery copy first." />
                            <CheckBox IsChecked="{Binding RestoreAcknowledged}"
                                      Content="I understand that this will replace my current vault." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Disabled until the acknowledgement is checked (ConfirmRestoreCommand.CanExecute);
                                     deliberately NOT the default button and not initially focused. -->
                                <Button Content="Replace my vault" Command="{Binding ConfirmRestoreCommand}" />
                                <!-- IsCancel routes the Escape key here; also receives initial focus (code-behind). -->
                                <Button x:Name="RestoreCancelButton" Content="Cancel"
                                        Command="{Binding CancelRestoreCommand}" IsCancel="True" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Security" Classes="h2" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Key derivation" Classes="muted" FontSize="12" />
                        <TextBlock Text="{Binding KdfDescription}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding KdfWarning}" TextWrapping="Wrap" Classes="error"
                                   IsVisible="{Binding KdfWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Encryption" Classes="muted" FontSize="12" />
                        <TextBlock Text="{Binding AlgorithmDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Clipboard" Classes="muted" FontSize="12" />
                        <TextBlock Text="{Binding ClipboardClearDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Server integration" Classes="muted" FontSize="12" />
                        <TextBlock Text="{Binding ServerIntegrationDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="About" Classes="h2" />
                    <TextBlock Text="{Binding AppVersion, StringFormat='BitosX version {0}'}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="This is the local-vault milestone. No data leaves your device." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
