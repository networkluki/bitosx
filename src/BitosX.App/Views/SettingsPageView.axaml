<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitosX.App.ViewModels"
             xmlns:controls="using:BitosX.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="680"
             x:Class="BitosX.App.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Classes="h1" />

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Vault" Classes="h2" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Vault file location" Classes="muted" FontSize="12" />
                        <SelectableTextBlock Name="VaultLocation" Text="{Binding VaultLocation}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Name="LockNowButton" AutomationProperties.Name="Lock now"
                            Command="{Binding LockVaultCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource BitosXLockIcon}" Width="14" Height="14"
                                      Foreground="{StaticResource BitosXWarningBrush}" />
                            <TextBlock Text="Lock now" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Auto-lock" Classes="h2" />

                    <CheckBox Name="AutoLockCheckBox" IsChecked="{Binding AutoLockOnInactivity}"
                              Content="Lock automatically after a period of inactivity" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsEnabled="{Binding AutoLockOnInactivity}">
                        <TextBlock Text="Lock after" VerticalAlignment="Center" />
                        <NumericUpDown Name="InactivityMinutesBox" AutomationProperties.Name="Minutes of no activity before the vault locks" Value="{Binding InactivityMinutes}" Minimum="1" Maximum="1440"
                                       Increment="1" FormatString="0" Width="120" />
                        <TextBlock Text="minutes of no activity in BitosX" VerticalAlignment="Center" Classes="muted" />
                    </StackPanel>

                    <CheckBox Name="LockOnMinimizeCheckBox" IsChecked="{Binding LockOnMinimize}"
                              Content="Lock when the window is minimized" />

                    <TextBlock Name="AutoLockStatus" Text="{Binding AutoLockStatus}" TextWrapping="Wrap" Classes="error"
                               IsVisible="{Binding AutoLockStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="Workstation lock" Classes="muted" FontSize="12" />
                        <TextBlock Name="SessionLockSupport" Text="{Binding SessionLockSupport}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="System sleep / suspend" Classes="muted" FontSize="12" />
                        <TextBlock Name="SuspendSupport" Text="{Binding SuspendSupport}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Change master password" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Re-protects your existing vault with a new password. The vault contents are not re-encrypted and no data is lost." />
                    <controls:SecretBox Name="CurrentPasswordBox" AutomationProperties.Name="Current password" PlaceholderText="Current password" Text="{Binding CurrentPassword}" />
                    <controls:SecretBox Name="NewPasswordBox" AutomationProperties.Name="New password" PlaceholderText="New password" Text="{Binding NewPassword}" />
                    <TextBlock Name="NewPasswordStrength" Text="{Binding NewPasswordStrengthText}" Classes="muted" FontSize="12"
                               IsVisible="{Binding NewPasswordStrengthText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <controls:SecretBox Name="ConfirmPasswordBox" AutomationProperties.Name="Confirm new password" PlaceholderText="Confirm new password" Text="{Binding ConfirmPassword}" />
                    <Button Name="ChangePasswordButton" Content="Change password" Command="{Binding ChangeMasterPasswordCommand}" HorizontalAlignment="Left" />
                    <TextBlock Name="ChangePasswordStatus" Text="{Binding ChangePasswordStatus}" TextWrapping="Wrap" Classes="muted"
                               IsVisible="{Binding ChangePasswordStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Rotate vault key" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Generates a new encryption key and re-encrypts your entire vault under it, retiring the previous key. Your items and master password are unchanged. Requires your current master password." />
                    <controls:SecretBox Name="RotatePasswordBox" AutomationProperties.Name="Current password, to rotate the vault key" PlaceholderText="Current password" Text="{Binding RotatePassword}" />
                    <Button Name="RotateVaultKeyButton" Content="Rotate vault key" Command="{Binding RotateVaultKeyCommand}" HorizontalAlignment="Left" />
                    <TextBlock Name="RotateStatus" Text="{Binding RotateStatus}" TextWrapping="Wrap" Classes="muted"
                               IsVisible="{Binding RotateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Strengthen key derivation" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Makes every guess at your master password more expensive for someone who has a copy of the vault file, by requiring more memory to derive the key. Unlocking takes longer and needs that memory on every device the vault is opened on. Your items and master password are unchanged. The settings can be strengthened, never weakened. Requires your current master password." />

                    <TextBlock Name="KeyDerivationAtStrongest" TextWrapping="Wrap"
                               Text="This vault already uses the strongest settings BitosX offers."
                               IsVisible="{Binding !CanStrengthenKeyDerivation}" />

                    <StackPanel Name="KeyDerivationPanel" Spacing="10" IsVisible="{Binding CanStrengthenKeyDerivation}">
                        <ComboBox Name="KeyDerivationChoices" AutomationProperties.Name="Key-derivation settings to move to" ItemsSource="{Binding KeyDerivationChoices}"
                                  SelectedItem="{Binding SelectedKeyDerivation}"
                                  DisplayMemberBinding="{Binding Display}" HorizontalAlignment="Stretch" />
                        <Button Name="TestKeyDerivationButton" Content="Measure on this device"
                                Command="{Binding TestKeyDerivationCommand}" HorizontalAlignment="Left" />
                        <TextBlock Name="KeyDerivationTestResult" Text="{Binding KeyDerivationTestResult}"
                                   TextWrapping="Wrap" Classes="muted"
                                   IsVisible="{Binding KeyDerivationTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <controls:SecretBox Name="StrengthenPasswordBox" AutomationProperties.Name="Current password, to strengthen the key derivation" PlaceholderText="Current password"
                                 Text="{Binding StrengthenPassword}" />
                        <Button Name="StrengthenKeyDerivationButton" Content="Strengthen key derivation"
                                Command="{Binding StrengthenKeyDerivationCommand}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock Name="StrengthenStatus" Text="{Binding StrengthenStatus}" TextWrapping="Wrap" Classes="muted"
                               IsVisible="{Binding StrengthenStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Backup &amp; Restore" Classes="h2" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="An encrypted backup is a copy of your vault, protected by the master password that was active when it was made. It contains no plaintext. BitosX cannot recover a forgotten backup password." />

                    <Button Name="ExportBackupButton" Content="Export encrypted backup…" Command="{Binding ExportBackupCommand}" HorizontalAlignment="Left" />
                    <TextBlock Name="BackupStatus" Text="{Binding BackupStatus}" TextWrapping="Wrap" Classes="muted"
                               IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Border Height="1" Background="#33888888" Margin="0,6" />

                    <TextBlock Text="Restore replaces your current vault." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Name="ChooseBackupButton" Grid.Column="0" Content="Choose backup file…" Command="{Binding ChooseRestoreFileCommand}" />
                        <!-- A file name too long for the line is shortened, and shown in full on hover. -->
                        <TextBlock Name="SelectedBackupName" Grid.Column="1" Text="{Binding SelectedBackupName}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Classes="muted"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedBackupName}"
                                   IsVisible="{Binding HasSelectedBackup}" />
                    </Grid>
                    <controls:SecretBox Name="RestorePasswordBox" AutomationProperties.Name="Master password of the backup" PlaceholderText="Backup master password" Text="{Binding RestoreBackupPassword}"
                             IsVisible="{Binding HasSelectedBackup}" />
                    <Button Name="ValidateBackupButton" Content="Validate backup" Command="{Binding ValidateRestoreCommand}" HorizontalAlignment="Left"
                            IsVisible="{Binding HasSelectedBackup}" />
                    <TextBlock Name="RestoreStatus" Text="{Binding RestoreStatus}" TextWrapping="Wrap" Classes="muted"
                               IsVisible="{Binding RestoreStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Border x:Name="RestoreConfirmPanel" IsVisible="{Binding IsRestorePending}" Padding="12" CornerRadius="6" Background="#22CC3333">
                        <StackPanel Spacing="8">
                            <TextBlock Text="This will REPLACE your current vault." FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Name="RestoreSummary" Text="{Binding RestoreSummary}" TextWrapping="Wrap" Classes="muted" />
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="After restoring, unlock with the backup's master password. Your current vault is saved as a recovery copy first." />
                            <CheckBox Name="RestoreAcknowledgeCheckBox" IsChecked="{Binding RestoreAcknowledged}"
                                      Content="I understand that this will replace my current vault." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Disabled until the acknowledgement is checked (ConfirmRestoreCommand.CanExecute);
                                     deliberately NOT the default button and not initially focused. -->
                                <Button Name="ReplaceVaultButton" Content="Replace my vault" Command="{Binding ConfirmRestoreCommand}" />
                                <!-- IsCancel routes the Escape key here; also receives initial focus (code-behind). -->
                                <Button x:Name="RestoreCancelButton" Content="Cancel"
                                        Command="{Binding CancelRestoreCommand}" IsCancel="True" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Security" Classes="h2" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Key derivation" Classes="muted" FontSize="12" />
                        <TextBlock Name="KdfDescription" Text="{Binding KdfDescription}" TextWrapping="Wrap" />
                        <TextBlock Name="KdfWarning" Text="{Binding KdfWarning}" TextWrapping="Wrap" Classes="error"
                                   IsVisible="{Binding KdfWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <StackPanel Spacing="2"
                                IsVisible="{Binding PasswordEncodingNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="Master password encoding" Classes="muted" FontSize="12" />
                        <TextBlock Name="PasswordEncodingNote" Text="{Binding PasswordEncodingNote}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Encryption" Classes="muted" FontSize="12" />
                        <TextBlock Name="AlgorithmDescription" Text="{Binding AlgorithmDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Clipboard" Classes="muted" FontSize="12" />
                        <TextBlock Name="ClipboardClearDescription" Text="{Binding ClipboardClearDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Server integration" Classes="muted" FontSize="12" />
                        <TextBlock Name="ServerIntegrationDescription" Text="{Binding ServerIntegrationDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="About" Classes="h2" />
                    <TextBlock Name="AppVersion" Text="{Binding AppVersion, StringFormat='BitosX version {0}'}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Your vault is encrypted on this device and never leaves it. The optional account (see the Account page) only signs you in to the BitosX server; it carries nothing from the vault." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
