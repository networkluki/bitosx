<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BitosX.Core\BitosX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows session/power notifications (workstation lock, suspend). The package is a
         cross-platform facade; its APIs are guarded behind OperatingSystem.IsWindows(). -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
