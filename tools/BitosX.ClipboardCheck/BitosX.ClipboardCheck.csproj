<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Diagnostic-only tool: places a marked secret on the real clipboard of Linux or macOS with the
    application's own clipboard code, and reads the clipboard back with the tools of the system
    (xclip, the pasteboard of AppKit) to see what is actually there. Not shipped. The counterpart
    for Windows, which also checks the clipboard history, is tools/BitosX.ClipboardProbe.
    See docs/VERIFICATION.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Console diagnostic tool: user-facing string localization analyzers do not apply. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BitosX.App\BitosX.App.csproj" />
  </ItemGroup>

</Project>
