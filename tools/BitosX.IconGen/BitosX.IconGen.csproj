<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Draws the BitosX icon from its geometry (Program.cs) and writes the files the application and
    the documentation use: the multi-size Windows icon and PNG files of several sizes. No image
    library, no font and no artwork from anywhere else: every pixel comes from the shapes below.
    Not part of the shipped application.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Console tool: user-facing string localization analyzers do not apply. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

</Project>
