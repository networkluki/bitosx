# Normalize line endings: Git stores text with LF and checks out native line endings.
* text=auto

# Explicit text types
*.cs      text
*.axaml   text
*.csproj  text
*.slnx    text
*.props   text
*.md      text
*.json    text
*.manifest text

# Binary types (never normalize)
*.ico     binary
*.png     binary

# Shell scripts run on Unix, whatever system they were checked out on.
*.sh      text eol=lf

# The import fixtures are read byte for byte, by this repository's tests and by the web vault's:
# their line ends are part of what is tested, and some of them are deliberately not text.
tests/fixtures/import/** -text
